{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "fs:default",
    "fs:allow-mkdir",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "C:/Program Files (x86)/Steam/steamapps/common/OmegaStrikers/OmegaStrikers.exe" },
        { "path": "$HOME/.steam/steam/steamapps/common/OmegaStrikers/OmegaStrikers.exe" }
      ]
    },
    "dialog:allow-open",
    "libsql:default"
  ]
}
